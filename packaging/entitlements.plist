<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Developer ID + Hardened Runtime (required for notarization).
      NOT sandboxed: a Developer-ID notarized app may shell out to ping/arp
      and open raw network sockets, which the LAN scanner relies on.
      The three exceptions below are needed because the bundle ships an
      embedded CPython that JITs and loads many self-signed .so/.dylib files.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
